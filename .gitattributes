# ──────────────────────────────────────────────
# 줄바꿈 정규화 (Windows ↔ Linux/Mac 코드 깨짐 방지)
# ──────────────────────────────────────────────

# 기본: 모든 텍스트 파일은 저장소에 LF, 체크아웃 시 플랫폼 자동 변환
* text=auto

# 명시적 LF 유지 파일
*.py        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.mjs       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf
*.env       text eol=lf
*.env.*     text eol=lf
*.sh        text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.sql       text eol=lf
Dockerfile  text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# 바이너리 파일 (변환 안 함)
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.svg       binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.whl       binary

# ML 모델 파일 — Git LFS 관리
models/portfolio/my_portfolio_adapter.gguf filter=lfs diff=lfs merge=lfs -text
