# ──────────────────────────────────────────────
# ELAW 프론트엔드 환경 변수 템플릿
# 복사 후 .env.local 로 이름 변경하세요:
#   Windows:  copy .env.example .env.local
#   Mac/Linux: cp .env.example .env.local
#
# 주의: NEXT_PUBLIC_ 접두사 변수는 브라우저에 노출됩니다.
# ──────────────────────────────────────────────

# 백엔드 API 주소 (기본값: http://localhost:8000)
# 배포 환경에서 실제 백엔드 주소로 변경하세요
# Vercel 배포 시: 프로젝트 Settings → Environment Variables 에 동일한 키로 등록
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Supabase 연동 (예정) ──────────────────────
# Supabase 프로젝트 생성 후 Settings → API 에서 값 확인
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
