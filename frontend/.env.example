# ──────────────────────────────────────────────
# ELAW 프론트엔드 환경 변수 템플릿
# 복사 후 .env.local 로 이름 변경하세요.
# 주의: NEXT_PUBLIC_ 접두사 변수는 브라우저에 노출됩니다.
# ──────────────────────────────────────────────

# 백엔드 API 주소 (브라우저용 — nginx 동일 오리진 구성에서는 빈 값 = 상대경로)
NEXT_PUBLIC_API_URL=http://localhost:8000

# 서버 컴포넌트(ISR)용 백엔드 내부 주소 (미설정 시 NEXT_PUBLIC_API_URL 사용)
API_URL=http://127.0.0.1:9002
