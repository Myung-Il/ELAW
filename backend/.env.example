# ──────────────────────────────────────────────
# ELAW 백엔드 환경 변수 템플릿
# 복사 후 .env 로 이름 변경하고 값을 채우세요:
#   Windows:  copy .env.example .env
#   Mac/Linux: cp .env.example .env
# ──────────────────────────────────────────────

# Django 필수 설정
DJANGO_SECRET_KEY=your-secret-key-change-this-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# AI API 키 (선택 — 없으면 커리큘럼 생성 시 기본 8주 폴백 사용)
GEMINI_API_KEY=

# GitHub API 토큰 (선택 — ETL rate limit 향상용)
GITHUB_TOKEN=

# 운영 DB (선택 — 미설정 시 SQLite 자동 사용)
#
# [Supabase Postgres] 대시보드 → Connect → Session pooler 탭의 값 사용
# DB_ENGINE=postgresql
# DB_NAME=postgres
# DB_USER=postgres.<프로젝트-ref>
# DB_PASSWORD=<Supabase DB 비밀번호>
# DB_HOST=aws-1-<region>.pooler.supabase.com
# DB_PORT=5432
#
# [MySQL]
# DB_ENGINE=mysql
# DB_NAME=elaw_db
# DB_USER=elaw_user
# DB_PASSWORD=your_db_password
# DB_HOST=localhost
# DB_PORT=3306
